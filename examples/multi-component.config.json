{
  "components": {
    "backend": {
      "description": "ASP.NET Core API: controllers, services, EF Core",
      "repo": ".",
      "path": "src/Api",
      "buildCommand": "dotnet build --nologo -v q",
      "testCommand": "dotnet test --nologo -v q",
      "lintCommand": "dotnet format --verify-no-changes",
      "lockedPaths": [
        "../../tests/Api.Tests/**"
      ],
      "allowedCommands": [
        "dotnet build",
        "dotnet test",
        "dotnet restore",
        "dotnet format"
      ]
    },
    "middleware": {
      "description": "Azure Functions that consume Service Bus messages and call the API",
      "repo": "../integrations",
      "path": ".",
      "buildCommand": "dotnet build --nologo -v q",
      "testCommand": "dotnet test --nologo -v q",
      "lockedPaths": [
        "tests/**"
      ],
      "allowedCommands": [
        "dotnet build",
        "dotnet test",
        "dotnet restore"
      ]
    },
    "frontend": {
      "description": "React + Vite SPA",
      "repo": "../web",
      "path": ".",
      "buildCommand": "npm run build",
      "testCommand": "npm test",
      "lintCommand": "npm run lint",
      "lockedPaths": [
        "src/**/*.test.tsx",
        "e2e/**"
      ],
      "allowedCommands": [
        "npm test",
        "npm run build",
        "npm run lint",
        "npx vitest"
      ]
    }
  },
  "models": {
    "enrich": "sonnet",
    "plan": "opus",
    "testAuthor": "sonnet",
    "coder": "sonnet",
    "diagnose": "opus",
    "review": "opus",
    "qaPlan": "haiku",
    "distill": "opus",
    "lead": "sonnet"
  },
  "efforts": {
    "plan": "high",
    "coder": "medium",
    "diagnose": "high",
    "review": "high"
  },
  "review": {
    "judges": [
      {
        "name": "security",
        "model": "opus",
        "effort": "high",
        "focus": "Focus on authentication, authorization, input validation and data exposure across the API, the Functions and the SPA."
      },
      {
        "name": "maintainer",
        "model": "sonnet",
        "focus": "Focus on correctness, contracts between components and consistency with existing conventions."
      }
    ]
  },
  "claudeSkills": {},
  "policy": {
    "maxParallel": 3,
    "repairAttempts": 5,
    "sameWorkerRetries": 2,
    "maxQuestions": 15,
    "undeclaredFiles": "revert",
    "reviewRounds": 1,
    "maxTurnsPerAgent": 40,
    "maxBudgetUsdPerAgent": 2
  },
  "notifyCommand": "curl -s -H 'Content-Type: application/json' -d \"{\\\"text\\\":\\\"hector-flow $HECTOR_TICKET: $HECTOR_STATUS ($HECTOR_OPEN_ASSUMPTIONS supuestos)\\\"}\" \"$TEAMS_WEBHOOK_URL\"",
  "workspacesDir": ".hector-workspaces"
}
