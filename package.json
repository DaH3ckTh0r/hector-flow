{
  "name": "hector-flow",
  "version": "0.12.0",
  "description": "Programmatic AI coding flow: TypeScript controls the workflow, agents only reason inside each step.",
  "type": "module",
  "bin": {
    "hector-flow": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "flow": "tsx src/cli.ts",
    "tutorial:setup": "node scripts/setup-tutorial.mjs",
    "test": "tsx test/runner-policy.ts && tsx test/runtimes.ts && tsx test/pi.ts && tsx test/usage.ts && tsx test/sandbox.ts && tsx test/e2e.ts && tsx test/loop.ts && tsx test/tutorial.ts",
    "test:loop": "tsx test/loop.ts",
    "test:tutorial": "tsx test/tutorial.ts",
    "test:e2e": "tsx test/e2e.ts",
    "test:runtimes": "tsx test/runtimes.ts",
    "test:usage": "tsx test/usage.ts",
    "test:sandbox": "tsx test/sandbox.ts",
    "test:pi": "tsx test/pi.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.305",
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "@github/copilot-sdk": "^1.0.24",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@openai/codex-sdk": "^0.163.0",
    "@opencode-ai/sdk": "^1.19.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.3.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
